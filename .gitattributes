* text=auto
*.md text eol=lf
*.json text eol=lf
*.jsonl text eol=lf

# Frozen rule inputs use exact bytes for audit hashes.
/reports/**/inputs/* -text -eol whitespace=cr-at-eol

# This completed run includes byte-pinned browser evidence and historical exports.
# Preserve its original line endings rather than invalidating audit hashes.
/reports/2026-10-01-to-05-01/** -text -eol whitespace=cr-at-eol,-blank-at-eof

# Migrated evidence keeps the exact original bytes; current manifests/docs use LF.
/reports/runs/** -text -eol whitespace=cr-at-eol,-blank-at-eof
/reports/reviews/** -text -eol whitespace=cr-at-eol,-blank-at-eof
/reports/**/README.md text eol=lf
/reports/**/publication.json text eol=lf
*.gz binary
*.zip binary
